# -- Supabase project (Settings -> API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# -- Server-only (Vercel env var too; never NEXT_PUBLIC) ---------------------
# Used by: student self-registration and student-number login lookup
# (src/lib/actions/auth.ts), scripts/tests, and scripts/seed*.mjs. Not used by
# any page render — the dean dashboard reads through the caller's own session,
# and the public /verify route reads through rpc_receipt_for (anon role).
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# -- Submission receipt signing (Ed25519 JWS) --------------------------------
# Generate once per environment: npm run db:key
# (production: store as a secret, never commit; the public key is served at
#  /.well-known/receipt-jwks.json for offline verification)
RECEIPT_SIGNING_KEY=

# -- Canonical public origin (QR codes on /verify point here) ----------------
# Set in production to the real domain, e.g. https://portal.example.edu
# Falls back to VERCEL_URL, then localhost, in dev.
NEXT_PUBLIC_SITE_URL=

# -- OPTIONAL, local scripts only --------------------------------------------
# Management API token for scripts/apply-mgmt-api.mjs + seed-remote.mjs.
# Project-admin scope: never commit, never send anywhere except
# api.supabase.com. If it stops working (401), generate a new one in the
# Supabase dashboard (Account -> Access Tokens).
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=your-project-ref

# -- OPTIONAL: direct Postgres (pooler, transaction mode port 6543) ----------
# Not required by the app. Used by scripts/apply-migrations.ts + seed.ts and
# the pg_dump restore drill.
# DATABASE_URL=postgresql://postgres.REF:DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
